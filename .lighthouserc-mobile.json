{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/blog",
        "http://localhost:3000/projects",
        "http://localhost:3000/about",
        "http://localhost:3000/search?q=test"
      ],
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "ready",
      "settings": {
        "preset": "mobile",
        "chromeFlags": "--no-sandbox --disable-gpu --headless",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1638.4,
          "uploadThroughputKbps": 675
        },
        "emulatedFormFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 667,
          "deviceScaleFactor": 2,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1200 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "speed-index": ["error", { "maxNumericValue": 2000 }],

        "interactive": ["warn", { "maxNumericValue": 4000 }],
        "first-meaningful-paint": ["warn", { "maxNumericValue": 1500 }],

        "unused-javascript": ["warn", { "maxNumericValue": 50000 }],
        "unused-css-rules": ["warn", { "maxNumericValue": 30000 }],
        "modern-image-formats": ["warn", { "maxNumericValue": 20000 }],
        "uses-optimized-images": ["warn", { "maxNumericValue": 15000 }],
        "uses-webp-images": ["warn", { "maxNumericValue": 15000 }],
        "uses-responsive-images": ["warn", { "maxNumericValue": 20000 }],
        "offscreen-images": ["warn", { "maxNumericValue": 15000 }],

        "render-blocking-resources": "warn",
        "uses-text-compression": "warn",
        "efficient-animated-content": "warn",
        "duplicated-javascript": "warn",
        "legacy-javascript": "warn",
        "tap-targets": ["warn", { "minScore": 0.9 }],
        "font-size": ["warn", { "minScore": 0.9 }],
        "viewport": "error"
      },
      "preset": "lighthouse:recommended"
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
