{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/blog",
        "http://localhost:3000/projects",
        "http://localhost:3000/about",
        "http://localhost:3000/search?q=test"
      ],
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "ready",
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu --headless",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0
        },
        "emulatedFormFactor": "desktop",
        "screenEmulation": {
          "mobile": false,
          "width": 1350,
          "height": 940,
          "deviceScaleFactor": 1,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1200 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "speed-index": ["error", { "maxNumericValue": 1500 }],

        "interactive": ["warn", { "maxNumericValue": 3000 }],
        "first-meaningful-paint": ["warn", { "maxNumericValue": 1200 }],

        "unused-javascript": ["warn", { "maxNumericValue": 40000 }],
        "unused-css-rules": ["warn", { "maxNumericValue": 20000 }],
        "modern-image-formats": ["warn", { "maxNumericValue": 15000 }],
        "uses-optimized-images": ["warn", { "maxNumericValue": 10000 }],
        "uses-webp-images": ["warn", { "maxNumericValue": 10000 }],
        "uses-responsive-images": ["warn", { "maxNumericValue": 15000 }],
        "offscreen-images": ["warn", { "maxNumericValue": 10000 }],

        "render-blocking-resources": "warn",
        "uses-text-compression": "warn",
        "efficient-animated-content": "warn",
        "duplicated-javascript": "warn",
        "legacy-javascript": "warn"
      },
      "preset": "lighthouse:recommended"
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
